{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "test:ars-muse": "node --test test/ars*.test.js",
    "eval:ars": "node scripts/evaluateArs.js",
    "serve": "firebase serve --only functions --port=9000",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions && npm run sentry:sourcemaps",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.76.0",
    "@google/genai": "^1.38.0",
    "@sentry/cli": "^2.39.1",
    "@sentry/google-cloud-serverless": "^8.42.0",
    "@sentry/profiling-node": "^8.42.0",
    "@xenova/transformers": "^2.17.2",
    "ajv": "^8.16.0",
    "axios": "^1.7.2",
    "chardet": "^2.1.1",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^7.2.5",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.2.3",
    "openai": "^6.16.0",
    "request-ip": "^3.3.0",
    "resend": "^6.10.0",
    "uuid": "^10.0.0",
    "xml2js": "^0.6.2"
  },
  "private": true,
  "_moduleAliases": {
    "@": ".",
    "@test": "__test__"
  }
}
